# Copy to .env, fill in, then run:
#   uv run --env-file .env stocks-on-the-move
# Every variable below is optional except the two Kite credentials.

KITE_API_KEY=
KITE_API_SECRET=

# Safety switches
ALLOW_KITE_EXECUTION=1     # 0 = compute and log orders without sending them
# KILL_SWITCH=1            # liquidate everything and exit
# FORCE_RESIZE=1           # resize positions even on an odd ISO week

# Universe / regime
# INDEX_SYMBOL=NIFTY 50
# INDEX_EXCHANGE=NSE
# USE_FULL_NIFTY_UNIVERSE=0

# Sizing and risk (defaults shown)
# STARTING_CASH=100000
# RISK_FACTOR=0.001        # fraction of equity risked per ATR
# ATR_PERIOD=20
# MAX_WEIGHT=0.10
# MAX_POSITIONS=25
# CUT_OFF_PCT=0.20
# EXIT_MULTIPLE=5.0
# MIN_VOLUME=10000
# MAX_ATR_PCT=0.10

# Scheduling (IST): 0=Mon ... 6=Sun
# TRADING_WEEKDAY=2

# Cash flows for this run (+ deposit / - withdrawal)
# ENV_CASHFLOW=0
# CASHFLOW_NOTE=env-cashflow

# Friction assumptions
# FEES_PCT=0.0015
# SLIPPAGE_PCT=0.0005

# Kite rate limiting
# KITE_RPS=2.0
# KITE_MAX_RETRIES=6
# CANDLE_SLEEP_SEC=0.15

# File locations
# PORTFOLIO_FILE=current_portfolio.csv
# OUT_FILE=next_portfolio.csv
# CASH_LEDGER_FILE=cash_ledger.csv
# TRADES_LEDGER_FILE=trades_ledger.csv
# CACHE_DIR=.cache_candles
