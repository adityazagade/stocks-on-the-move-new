# Generated from src/stocks_on_the_move/settings.py by
#   uv run python -m stocks_on_the_move.settings --example > .env.example
# Edit the model, not this file; a test keeps the two identical.
#
# Copy to .env, fill in the two credentials, then run:
#   uv run --env-file .env stocks-on-the-move
# Commented lines show the default; uncomment to override.
# Booleans accept 1/0, true/false, yes/no, on/off. Anything else refuses to start.

# ── Kite credentials (required) ──
# Kite Connect API key from the developer console.
KITE_API_KEY=
# Kite Connect API secret. Rotate it if it ever lands in a chat or a log.
KITE_API_SECRET=

# ── Kite session (ADR-005) ──
# Where the day's access token is cached, mode 0600. A leading ~ expands.
# KITE_SESSION_FILE=~/.config/stocks-on-the-move/kite_session.json
# Loopback port that captures the login redirect. The app's redirect URL in the Kite console must
# be http://127.0.0.1:<port>/. 0 disables the listener; the token is pasted instead.
# Range: at least 0, at most 65535.
# KITE_REDIRECT_PORT=8765
# Open the login URL in the default browser.
# KITE_OPEN_BROWSER=1
# Discard the cached session and log in afresh.
# KITE_FORGET_SESSION=0

# ── Safety switches ──
# 0 = paper mode: run the whole pipeline and write the ledgers, but send no orders.
# ALLOW_KITE_EXECUTION=1
# 1 = liquidate everything and exit, ignoring the weekday guard.
# KILL_SWITCH=0
# 1 = rebalance position sizes even on an odd ISO week.
# FORCE_RESIZE=0

# ── Universe and regime ──
# Index whose 200-day EMA sets the bull or bear regime.
# INDEX_SYMBOL=NIFTY 50
# Exchange segment of that index.
# INDEX_EXCHANGE=NSE
# 1 = rank every NSE equity instead of the NIFTY 500 constituents.
# USE_FULL_NIFTY_UNIVERSE=0

# ── Sizing and risk ──
# Legacy account size. Only the default for STARTING_CASH.
# Range: at least 0.
# ACCOUNT_VALUE=100000
# Cash before any ledger row. Changing it changes the meaning of every historical row.
# Range: at least 0.
# STARTING_CASH=<same as ACCOUNT_VALUE>
# Fraction of equity risked per ATR when sizing a position.
# Range: at least 0.
# RISK_FACTOR=0.001
# Days in the ATR used for sizing and the trailing stop.
# Range: more than 0.
# ATR_PERIOD=20
# Cap on one position as a fraction of equity.
# Range: more than 0, at most 1.
# MAX_WEIGHT=0.1
# Stop opening new positions at this count.
# Range: more than 0.
# MAX_POSITIONS=25
# Hold and buy only names ranked in this top fraction of the universe.
# Range: more than 0, at most 1.
# CUT_OFF_PCT=0.2
# Trailing stop: sell when the close is this many ATRs below the 40-day high close.
# Range: more than 0.
# EXIT_MULTIPLE=5
# Minimum 20-day average volume for a name to be ranked.
# Range: at least 0.
# MIN_VOLUME=10000
# Skip names whose ATR exceeds this fraction of their price.
# Range: more than 0.
# MAX_ATR_PCT=0.1

# ── Scheduling ──
# Weekday (IST) the run is allowed on: 0 = Monday ... 6 = Sunday.
# Range: at least 0, at most 6.
# TRADING_WEEKDAY=2

# ── Cash flow for this run ──
# Deposit (+) or withdrawal (-) appended to the cash ledger when the run starts. Set it for
# exactly one run; never leave it in .env.
# ENV_CASHFLOW=0
# Note column of that ledger row.
# CASHFLOW_NOTE=env-cashflow

# ── Friction ──
# All-in fee fraction booked on every trade.
# Range: at least 0.
# FEES_PCT=0.0015
# Slippage fraction booked on every trade.
# Range: at least 0.
# SLIPPAGE_PCT=0.0005

# ── Kite rate limiting ──
# Ceiling on Kite REST calls per second (floored at 0.1).
# Range: at least 0.
# KITE_RPS=2
# Attempts per Kite call while it answers 'too many requests'.
# Range: at least 1.
# KITE_MAX_RETRIES=6
# Pause after each historical-data download.
# Range: at least 0.
# CANDLE_SLEEP_SEC=0.15

# ── Logging ──
# Console log level. The run's log file under RUNS_DIR always gets DEBUG.
# LOG_LEVEL=INFO

# ── Files ──
# Positions going into the run: SYMBOL,QUANTITY.
# PORTFOLIO_FILE=current_portfolio.csv
# Positions after the run.
# OUT_FILE=next_portfolio.csv
# Deposits and withdrawals: date, amount, note.
# CASH_LEDGER_FILE=cash_ledger.csv
# Every placed or paper trade and its cash effect.
# TRADES_LEDGER_FILE=trades_ledger.csv
# Per-instrument daily-candle cache; regenerable.
# CACHE_DIR=.cache_candles
# Per-run artifacts (ADR-006): a directory per run with the ranking, exits, sizes, trades and log.
# RUNS_DIR=runs
