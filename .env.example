# Generated from src/stocks_on_the_move/settings.py by
#   uv run python -m stocks_on_the_move.settings --example > .env.example
# Edit the model, not this file; a test keeps the two identical.
#
# Copy to .env, fill in the two credentials, then run:
#   uv run --env-file .env stocks-on-the-move
# Commented lines show the default; uncomment to override.
# Booleans accept 1/0, true/false, yes/no, on/off. Anything else refuses to start.

# ── Kite credentials (required) ──
# Kite Connect API key from the developer console.
KITE_API_KEY=
# Kite Connect API secret. Rotate it if it ever lands in a chat or a log.
KITE_API_SECRET=

# ── Kite session (ADR-005) ──
# Where the day's access token is cached, mode 0600. A leading ~ expands.
# KITE_SESSION_FILE=~/.config/stocks-on-the-move/kite_session.json
# Loopback port that captures the login redirect. The app's redirect URL in the Kite console must
# be http://127.0.0.1:<port>/. 0 disables the listener; the token is pasted instead.
# Range: at least 0, at most 65535.
# KITE_REDIRECT_PORT=8765
# Open the login URL in the default browser.
# KITE_OPEN_BROWSER=1
# Discard the cached session and log in afresh.
# KITE_FORGET_SESSION=0

# ── Safety switches ──
# 0 = paper mode: run the whole pipeline and write the ledgers, but send no orders.
# ALLOW_KITE_EXECUTION=1
# 1 = liquidate everything and exit, ignoring the weekday guard.
# KILL_SWITCH=0
# 1 = rebalance position sizes even when the last rebalance was under 12 days ago.
# FORCE_RESIZE=0
# 1 = decide everything, send nothing, write no state: the plan goes to the run directory and the
# console (ADR-022). Wins over ALLOW_KITE_EXECUTION and skips the weekday guard.
# PLAN_ONLY=0

# ── Universe and regime ──
# Index whose 200-day moving average sets the bull or bear regime.
# INDEX_SYMBOL=NIFTY 50
# Exchange segment of that index.
# INDEX_EXCHANGE=NSE
# 1 = rank every NSE equity instead of the NIFTY 500 constituents.
# USE_FULL_NIFTY_UNIVERSE=0

# ── Sizing and risk ──
# Legacy account size. Only the default for STARTING_CASH.
# Range: at least 0.
# ACCOUNT_VALUE=0
# Cash before any ledger row. Changing it changes the meaning of every historical row.
# Range: at least 0.
# STARTING_CASH=<same as ACCOUNT_VALUE>
# Fraction of equity risked per ATR when sizing a position.
# Range: at least 0.
# RISK_FACTOR=0.001
# Days in the ATR used for sizing and the trailing stop.
# Range: more than 0.
# ATR_PERIOD=20
# Cap on one position as a fraction of equity.
# Range: more than 0, at most 1.
# MAX_WEIGHT=0.1
# Stop opening new positions at this count.
# Range: more than 0.
# MAX_POSITIONS=25
# Open a new position only when the cash covers at least this fraction of its target size
# (ADR-026). 1 = full positions only, the book's rule; 0 = buy whatever the cash covers.
# Range: at least 0, at most 1.
# MIN_POSITION_FRACTION=0.5
# Hold and buy only names ranked in this top fraction of the ranking. Since ADR-033 the ranking is
# every scoreable name in the universe, not only those that pass the entry filters, so this
# fraction covers more names than it did.
# Range: more than 0, at most 1.
# CUT_OFF_PCT=0.2
# Trailing stop: sell when the close is this many ATRs below the 40-day high close.
# Range: more than 0.
# EXIT_MULTIPLE=5
# Minimum 20-day average volume for a name to be ranked.
# Range: at least 0.
# MIN_VOLUME=10000
# Skip names whose ATR exceeds this fraction of their price.
# Range: more than 0.
# MAX_ATR_PCT=0.1
# Skip, and exit, names whose largest one-day close-to-close move in the last 90 trading days is
# at least this fraction (ADR-025). 1 disables the rule.
# Range: at least 0, at most 1.
# MAX_GAP_PCT=0.15
# Open a new position only in a name whose daily price band is at least this percent (ADR-034). A
# 2% band marks ESM Stage II, which trades only in periodic call auctions: 5 excludes that and
# nothing else, 10 also excludes every 5% surveillance band. 'No Band' (the F&O names) always
# passes; 0 disables.
# Range: at least 0.
# MIN_PRICE_BAND_PCT=5

# ── Scheduling ──
# Weekday (IST) the run is allowed on: 0 = Monday ... 6 = Sunday.
# Range: at least 0, at most 6.
# TRADING_WEEKDAY=2

# ── Cash flow for this run ──
# Deposit (+) or withdrawal (-) appended to the cash ledger when the run starts. Set it for
# exactly one run; never leave it in .env.
# ENV_CASHFLOW=0
# Note column of that ledger row.
# CASHFLOW_NOTE=env-cashflow

# ── Friction ──
# All-in fee fraction booked on every trade.
# Range: at least 0.
# FEES_PCT=0.0015
# Slippage fraction booked on every trade.
# Range: at least 0.
# SLIPPAGE_PCT=0.0005

# ── Order placement and confirmation (ADR-019, ADR-034) ──
# Seconds to wait for an order to fill before cancelling what has not.
# Range: at least 1, at most 900.
# FILL_TIMEOUT_SECONDS=120
# Seconds between two order-status polls.
# Range: at least 0.5, at most 30.
# FILL_POLL_SECONDS=2
# Do not send a limit BUY whose best ask is more than this fraction above the last price
# (ADR-034). Applies to the series without market orders, where the top of a thin book can sit at
# the circuit; a SELL is never held back. 0 buys only at or below the last price.
# Range: at least 0.
# MAX_ENTRY_SLIPPAGE_PCT=0.03

# ── Kite rate limiting ──
# Ceiling on Kite REST calls per second (floored at 0.1).
# Range: at least 0.
# KITE_RPS=2
# Attempts per Kite call while it answers 'too many requests'.
# Range: at least 1.
# KITE_MAX_RETRIES=6
# Pause after each historical-data download.
# Range: at least 0.
# CANDLE_SLEEP_SEC=0.15

# ── Logging ──
# Console log level. The run's log file under RUNS_DIR always gets DEBUG.
# LOG_LEVEL=INFO

# ── Files ──
# The account's directory, git-ignored (ADR-029): the five state files at its root and one
# <date>/<time>-<mode>/ directory per run with the ranking, exits, sizes, trades and log
# (ADR-006).
# RUNS_DIR=runs
# Positions going into the run: SYMBOL,QUANTITY. Lives at the root of RUNS_DIR unless set.
# PORTFOLIO_FILE=runs/current_portfolio.csv
# Positions after the run. Lives at the root of RUNS_DIR unless set.
# OUT_FILE=runs/next_portfolio.csv
# Deposits and withdrawals: date, amount, note. Lives at the root of RUNS_DIR unless set.
# CASH_LEDGER_FILE=runs/cash_ledger.csv
# Every placed or paper trade and its cash effect. Lives at the root of RUNS_DIR unless set.
# TRADES_LEDGER_FILE=runs/trades_ledger.csv
# The run's own state (ADR-027): the date of the last size rebalance. Lives at the root of
# RUNS_DIR unless set.
# STATE_FILE=runs/strategy_state.json
# Per-instrument daily-candle cache; regenerable.
# CACHE_DIR=.cache_candles
