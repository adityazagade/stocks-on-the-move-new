# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Tool caches
.ruff_cache/
.pytest_cache/

# Secrets (copy .env.example -> .env)
.env

# Kite access token cached by the run (ADR-005). It lives under ~/.config by default;
# these patterns guard against KITE_SESSION_FILE being pointed into the tree.
kite_session.json
.kite_session*.json

# Candle cache written by the strategy (thousands of CSVs, fully regenerable)
.cache_candles/

# The account lives in runs/ and is never committed (ADR-029, superseding ADR-004):
# the five state files at its root (current_portfolio.csv, next_portfolio.csv,
# cash_ledger.csv, trades_ledger.csv, strategy_state.json) and the per-run
# diagnostics under <date>/<time>-<mode>/ (ADR-006). Back this directory up.
runs/

# The same five names at the checkout root, in case a *_FILE setting is pointed
# back there. Anchored: tests/fixtures/golden/ carries two of these names on purpose.
/current_portfolio.csv
/next_portfolio.csv
/cash_ledger.csv
/trades_ledger.csv
/strategy_state.json

# Editors / OS
.idea/
.DS_Store

# Personal Claude Code permissions
.claude/settings.local.json
