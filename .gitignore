# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Tool caches
.ruff_cache/
.pytest_cache/

# Secrets (copy .env.example -> .env)
.env

# Kite access token cached by the run (ADR-005). It lives under ~/.config by default;
# these patterns guard against KITE_SESSION_FILE being pointed into the tree.
kite_session.json
.kite_session*.json

# Candle cache written by the strategy (thousands of CSVs, fully regenerable)
.cache_candles/

# Per-run artifacts (ADR-006). The rule: state the code reads in order to run is
# versioned (the ledgers below); diagnostics the code produces are not.
runs/

# The ledgers below hold live portfolio and trade history. They are tracked on
# purpose so the repo doubles as a record of the account. Uncomment to exclude.
# current_portfolio.csv
# next_portfolio.csv
# cash_ledger.csv
# trades_ledger.csv

# Editors / OS
.idea/
.DS_Store

# Personal Claude Code permissions
.claude/settings.local.json
